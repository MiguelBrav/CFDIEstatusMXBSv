@page "/"
@rendermode InteractiveServer
@using CFDIEstatusMXBSv.Interfaces
@using CFDIEstatusMXBSv.Models
@using CFDIEstatusMXBSv.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text.Json

<PageTitle>CFDI Estatus MX</PageTitle>

@inject IConsultaCFDIService ConsultaService
@inject IXmlImportaService XmlImportService
@inject PdfService PdfService
@inject IJSRuntime JS

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light bg-gradient py-5">

    <div class="container" style="max-width: 800px;">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-primary text-white p-4 text-center">
                <i class="bi bi-qr-code-scan fs-1 mb-2"></i>
                <h3 class="fw-bold mb-0">Validador de CFDI</h3>
                <p class="mb-0 opacity-75 small">Consulta al servicio del SAT</p>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <EditForm Model="@expresion" OnValidSubmit="ConsultarDatos" FormName="ConsultaCfdiForm">
                    <DataAnnotationsValidator />

                    <h6 class="text-secondary text-uppercase fw-bold mb-3 small">
                        <i class="bi bi-person-vcard me-2"></i>Datos Fiscales
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <InputText class="form-control bg-light" placeholder="RFC Emisor" @bind-Value="expresion.Emisor" />
                                <label>RFC Emisor</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <InputText class="form-control bg-light" placeholder="RFC Receptor" @bind-Value="expresion.Receptor" />
                                <label>RFC Receptor</label>
                            </div>
                        </div>
                    </div>

                    <h6 class="text-secondary text-uppercase fw-bold mb-3 mt-4 small">
                        <i class="bi bi-cash-coin me-2"></i>Datos del Comprobante
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <InputNumber @typeparam="decimal" step="0.01" placeholder="0.00" class="form-control bg-light fw-bold text-primary" @bind-Value="expresion.Total" />
                                <label>Total Factura</label>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-floating">
                                <InputText class="form-control bg-light" placeholder="UUID" @bind-Value="expresion.Id" />
                                <label>Folio Fiscal (UUID)</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <InputText class="form-control bg-light" placeholder="Sello FE" @bind-Value="expresion.FE" />
                        <label>Sello (Últimos 8 caracteres)</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold py-3 transition-btn" disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Conectando con SAT...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-search me-2"></i>Validar Estatus Ahora</span>
                        }
                    </button>

                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="OpenImportModal">
                            <i class="bi bi-file-earmark-arrow-up me-2"></i> Importar XML
                        </button>
                        <button type="button" class="btn btn-outline-info btn-sm rounded-pill" @onclick="OpenHistoricoModal">
                            <i class="bi bi-clock-history me-2"></i> Ver Histórico (@historicoConsultas.Count)
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" @onclick="ClearForm">
                            <i class="bi bi-trash me-2"></i> Limpiar formulario
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" @onclick="GenerarPdf" disabled="@(!PuedeGenerarPdf)">
                            <i class="bi bi-file-earmark-pdf me-2"></i> Descargar PDF
                        </button>
                    </div>
                </EditForm>

                @if (showImportModal)
                {
                    <div class="modal-backdrop fade show"></div>
                    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        <i class="bi bi-file-earmark-arrow-up me-2"></i>Importar CFDI desde XML
                                    </h5>
                                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseImportModal"></button>
                                </div>

                                <div class="modal-body">
                                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <strong>Selecciona un archivo XML</strong> para cargar datos automáticamente en el formulario.
                                    </div>

                                    <InputFile OnChange="HandleFileSelected" accept=".xml,application/xml" />

                                    @if (erroresImportacion?.Count > 0)
                                    {
                                        <div class="alert alert-danger mt-3">
                                            <ul class="mb-0">
                                                @foreach (var err in erroresImportacion)
                                                {
                                                    <li>@err</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    @if (vistaPreviaImport is not null)
                                    {
                                        <div class="mt-3 p-3 bg-light rounded">
                                            <h6 class="text-secondary mb-3"><i class="bi bi-preview me-2"></i>Vista Previa</h6>
                                            <div><strong>RFC Emisor:</strong> @vistaPreviaImport.Emisor</div>
                                            <div><strong>RFC Receptor:</strong> @vistaPreviaImport.Receptor</div>
                                            <div><strong>Total:</strong> @vistaPreviaImport.Total.ToString("C2")</div>
                                            <div><strong>UUID:</strong> @vistaPreviaImport.Id</div>
                                            <div><strong>Sello FE (últimos 8):</strong> @vistaPreviaImport.FE</div>
                                        </div>
                                    }
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-secondary" @onclick="CloseImportModal">Cerrar</button>
                                    <button class="btn btn-primary" @onclick="LoadPreviewToForm" disabled="@((vistaPreviaImport is null) || (erroresImportacion?.Count > 0))">
                                        <i class="bi bi-check-lg me-1"></i>Cargar en formulario
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- MODAL SEPARADA: HISTÓRICO -->
                @if (showHistoricoModal)
                {
                    <div class="modal-backdrop fade show"></div>
                    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title">
                                        <i class="bi bi-clock-history me-2"></i>Histórico de Consultas
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="CloseHistoricoModal"></button>
                                </div>

                                <div class="modal-body">
                                    @if (historicoConsultas.Count == 0)
                                    {
                                        <div class="text-center text-muted py-5">
                                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                            <p class="mb-1"><strong>No hay consultas en el histórico</strong></p>
                                            <small>Los CFDIs validados contra el SAT aparecerán aquí</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>UUID</th>
                                                        <th>Emisor</th>
                                                        <th>Total</th>
                                                        <th>Estado</th>
                                                        <th>Fecha</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var consulta in historicoConsultas.OrderByDescending(x => x.FechaConsulta))
                                                    {
                                                        var colorEstatus = ObtenerColorEstatus(consulta.Estatus);
                                                        <tr>
                                                            <td>
                                                                <small class="text-monospace" title="@consulta.Id">@consulta.Id?.Substring(0, Math.Min(8, consulta.Id.Length))...</small>
                                                            </td>
                                                            <td>
                                                                <small>@consulta.Emisor</small>
                                                            </td>
                                                            <td>
                                                                <small>@consulta.Total.ToString("C2")</small>
                                                            </td>
                                                            <td>
                                                                @if (string.IsNullOrEmpty(consulta.Estatus))
                                                                {
                                                                    <span class="badge bg-secondary">Sin consultar</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-@colorEstatus">@consulta.Estatus</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <small>@consulta.FechaConsulta.ToString("dd/MM/yyyy HH:mm")</small>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="LimpiarHistorico" disabled="@(historicoConsultas.Count == 0)">
                                        <i class="bi bi-trash me-1"></i>Limpiar histórico
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="ExportarHistoricoCSV" disabled="@(historicoConsultas.Count == 0)">
                                        <i class="bi bi-download me-1"></i>Exportar CSV
                                    </button>
                                    <button class="btn btn-secondary" @onclick="CloseHistoricoModal">
                                        <i class="bi bi-x-lg me-1"></i>Cerrar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (respuesta is not null && !string.IsNullOrWhiteSpace(respuesta.CodigoEstatus))
                {
                    var colorBase = ObtenerColorEstatus(respuesta.Estatus);
                    var iconoEstatus = ObtenerIconoEstatus(respuesta.Estatus);

                    <div class="mt-5 animate__animated animate__fadeIn">
                        <div class="alert alert-@colorBase border-@colorBase border-opacity-50 shadow-sm rounded-4" role="alert">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-@colorBase text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi @iconoEstatus fs-4"></i>
                                </div>
                                <div>
                                    <h5 class="alert-heading fw-bold mb-0">@respuesta.Estatus</h5>
                                    <small class="text-muted">Respuesta</small>
                                </div>
                            </div>

                            <hr>

                            <div class="row g-3 text-center">
                                <div class="col-4 border-end">
                                    <small class="d-block text-muted text-uppercase" style="font-size: 0.7rem;">Código</small>
                                    <span class="fw-bold text-dark">@respuesta.CodigoEstatus</span>
                                </div>
                                <div class="col-4 border-end">
                                    <small class="d-block text-muted text-uppercase" style="font-size: 0.7rem;">Es Cancelable</small>
                                    <span class="fw-bold text-dark">@(string.IsNullOrEmpty(respuesta.EsCancelable) ? "N/A" : respuesta.EsCancelable)</span>
                                </div>
                                <div class="col-4">
                                    <small class="d-block text-muted text-uppercase" style="font-size: 0.7rem;">Estado Cancelación</small>
                                    <span class="fw-bold text-dark">@(string.IsNullOrEmpty(respuesta.EstatusCancelacion) ? "Sin proceso" : respuesta.EstatusCancelacion)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="text-center mt-4 text-muted">
            <small>
                <i class="bi bi-shield-lock me-1"></i>
                Copyright © @DateTime.Now.Year Miguel Segura.
            </small>
        </div>
    </div>
</div>

@code {
    // Import modal state
    private bool showImportModal = false;
    private bool showHistoricoModal = false;
    private ConsultaModel? vistaPreviaImport;
    private List<string>? erroresImportacion;
    private List<ConsultaCFDIHistorico> historicoConsultas = new();

    [SupplyParameterFromForm(FormName = "ConsultaCfdiForm")]
    private ConsultaModel expresion { get; set; } = new();

    private ConsultaCFDIResponse respuesta = new();
    private bool cargando = false;
    private bool PuedeGenerarPdf =>
        !string.IsNullOrWhiteSpace(expresion.Emisor)
        && !string.IsNullOrWhiteSpace(expresion.Receptor)
        && expresion.Total > 0
        && !string.IsNullOrWhiteSpace(expresion.Id)
        && !string.IsNullOrWhiteSpace(expresion.FE);

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorico();
    }

    private async Task CargarHistorico()
    {
        try
        {
            historicoConsultas = await JS.InvokeAsync<List<ConsultaCFDIHistorico>>("localStorageService.obtenerHistorico") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando histórico: {ex.Message}");
            historicoConsultas = new();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        vistaPreviaImport = null;
        erroresImportacion = null;

        var file = e.File;
        try
        {
            await using var stream = file.OpenReadStream(10_000_000);
            var (model, errors) = await XmlImportService.ParseXmlAsync(stream);
            vistaPreviaImport = model;
            erroresImportacion = errors;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            erroresImportacion = new List<string> { "Error al leer archivo: " + ex.Message };
        }
    }

    private void CloseImportModal()
    {
        showImportModal = false;
        vistaPreviaImport = null;
        erroresImportacion = null;
    }

    private void OpenImportModal()
    {
        // Clear previous import preview/errors when opening modal
        vistaPreviaImport = null;
        erroresImportacion = null;
        showImportModal = true;
    }

    private void CloseHistoricoModal()
    {
        showHistoricoModal = false;
    }

    private void OpenHistoricoModal()
    {
        showHistoricoModal = true;
    }

    private void ClearForm()
    {
        expresion = new ConsultaModel();
        respuesta = new ConsultaCFDIResponse();
        vistaPreviaImport = null;
        erroresImportacion = null;
        StateHasChanged();
    }

    private void LoadPreviewToForm()
    {
        if (vistaPreviaImport is null) return;

        expresion.Emisor = vistaPreviaImport.Emisor;
        expresion.Receptor = vistaPreviaImport.Receptor;
        expresion.Total = vistaPreviaImport.Total;
        expresion.Id = vistaPreviaImport.Id;
        expresion.FE = vistaPreviaImport.FE;

        showImportModal = false;
    }

    private async Task ConsultarDatos()
    {
        cargando = true;
        respuesta = new();
        try
        {
            respuesta = await ConsultaService.ConsultarAsync(expresion);

            // Guardar en histórico solo si la consulta fue exitosa
            if (!string.IsNullOrWhiteSpace(respuesta.CodigoEstatus))
            {
                var historico = new ConsultaCFDIHistorico
                {
                    Id = expresion.Id,
                    Emisor = expresion.Emisor,
                    Receptor = expresion.Receptor,
                    Total = expresion.Total,
                    FE = expresion.FE,
                    CodigoEstatus = respuesta.CodigoEstatus,
                    Estatus = respuesta.Estatus,
                    EsCancelable = respuesta.EsCancelable,
                    EstatusCancelacion = respuesta.EstatusCancelacion,
                    FechaConsulta = DateTime.Now
                };

                await GuardarEnHistorico(historico);
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarEnHistorico(ConsultaCFDIHistorico historico)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorageService.guardarConsultaHistorico", historico);
            await CargarHistorico();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error guardando en histórico: {ex.Message}");
        }
    }

    private async Task ExportarHistoricoCSV()
    {
        try
        {
            var csv = await JS.InvokeAsync<string>("localStorageService.exportarACSV");
            if (!string.IsNullOrEmpty(csv))
            {
                await JS.InvokeVoidAsync("localStorageService.descargarCSV", csv);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exportando a CSV: {ex.Message}");
        }
    }

    private async Task LimpiarHistorico()
    {
        if (await JS.InvokeAsync<bool>("window.confirm", "¿Está seguro de que desea limpiar todo el histórico?"))
        {
            try
            {
                await JS.InvokeVoidAsync("localStorageService.limpiarHistorico");
                await CargarHistorico();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error limpiando histórico: {ex.Message}");
            }
        }
    }

    private async Task GenerarPdf()
    {
        if (!PuedeGenerarPdf)
        {
            return;
        }

        var resultadoConsulta = string.IsNullOrWhiteSpace(respuesta.CodigoEstatus) ? null : respuesta;
        var pdfBytes = PdfService.GenerarConsultaPdf(expresion, resultadoConsulta);
        var base64 = Convert.ToBase64String(pdfBytes);
        var identificadorUnico = Guid.NewGuid().ToString("N")[..8];

        await JS.InvokeVoidAsync("downloadFile", $"consulta-{identificadorUnico}.pdf", base64);
    }
    // Helpers
    private string ObtenerColorEstatus(string estatus)
    {
        if (string.IsNullOrEmpty(estatus)) return "secondary";
        return estatus.ToLower() switch
        {
            "vigente" => "success",
            "cancelado" => "danger",
            "no encontrado" => "warning",
            _ => "primary"
        };
    }

    private string ObtenerIconoEstatus(string estatus)
    {
        if (string.IsNullOrEmpty(estatus)) return "bi-question-lg";
        return estatus.ToLower() switch
        {
            "vigente" => "bi-check-lg",
            "cancelado" => "bi-x-lg",
            "no encontrado" => "bi-exclamation-triangle",
            _ => "bi-info-lg"
        };
    }
}
